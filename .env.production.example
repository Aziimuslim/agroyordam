# ===== AgroYordam — PRODUCTION sozlamalari =====
# Nusxa oling: cp .env.production.example .env  va quyidagilarni to'ldiring.

# Domeningiz (DNS'da A yozuvi server IP manziliga yo'naltirilgan bo'lishi kerak)
DOMAIN=agroyordam.uz

# Tasodifiy qiymatlar: openssl rand -hex 32
SECRET_KEY=
POSTGRES_PASSWORD=

POSTGRES_USER=agro
POSTGRES_DB=agroyordam
STORAGE_BACKEND=local   # rasmlar Docker volume'da (backup'ga kiradi)
REDIS_URL=redis://redis:6379/0

IMAGE_REGISTRY=agroyordam

FREE_AI_DAILY_LIMIT=3
FREE_CROP_LIMIT=3
AI_MIN_CONFIDENCE=60

# To'lovlar: sandbox (ilova ichida test) | live (haqiqiy Payme/Click)
PAYMENT_MODE=sandbox
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=

# Push-bildirishnomalar (ixtiyoriy)
FCM_SERVER_KEY=

# Server tashqarisidagi zaxira nusxa (ixtiyoriy, tavsiya) — sozlash: sudo bash deploy/enable-offsite-backup.sh
# Oracle: OFFSITE_S3_ENDPOINT=https://<namespace>.compat.objectstorage.eu-frankfurt-1.oraclecloud.com
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_REGION=
OFFSITE_S3_BUCKET=
OFFSITE_S3_ACCESS_KEY=
OFFSITE_S3_SECRET_KEY=
BACKUP_KEEP_DAYS=30

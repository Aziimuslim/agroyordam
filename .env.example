# ===== AgroYordam 0.1 — muhit o'zgaruvchilari =====
ENVIRONMENT=development
SECRET_KEY=replace-with-64-random-chars

POSTGRES_USER=agro
POSTGRES_PASSWORD=agro
POSTGRES_DB=agroyordam
DATABASE_URL=postgresql+asyncpg://agro:agro@db:5432/agroyordam
REDIS_URL=redis://redis:6379/0

AI_SERVICE_URL=http://ai-service:8001
AI_MIN_CONFIDENCE=60

STORAGE_BACKEND=local
# Tashqi S3 (ixtiyoriy): STORAGE_BACKEND=s3, S3_ENDPOINT_URL, S3_ACCESS_KEY, S3_SECRET_KEY, S3_BUCKET, S3_PUBLIC_URL

CORS_ORIGINS=http://localhost,http://localhost:8080

FREE_AI_DAILY_LIMIT=3
FREE_CROP_LIMIT=3

# To'lov: sandbox | live. Live rejim uchun provayder kalitlarini kiriting
PAYMENT_MODE=sandbox
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=payme-sandbox-secret
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=click-sandbox-secret
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=uzum-sandbox-secret
PAYMENT_RETURN_URL=http://localhost/premium

FCM_SERVER_KEY=
SEED_DEMO_DATA=true

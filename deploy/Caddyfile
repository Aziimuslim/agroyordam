# Avtomatik HTTPS (Let's Encrypt). DOMAIN .env faylidan olinadi.
{$DOMAIN} {
	encode zstd gzip

	# Web ilova + API + WebSocket + /media rasmlari (nginx orqali)
	reverse_proxy web:80

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
